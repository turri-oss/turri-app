{
  "name": "turri-app",
  "version": "0.0.1",
  "private": true,
  "description": "A proof of concept: turri as a native desktop app, for people who do not live in a terminal.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "postinstall": "node scripts/brand.mjs",
    "brand": "node scripts/brand.mjs",
    "icon": "electron scripts/icon.cjs && node scripts/brand.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@turri-dev/cli": "0.1.7-next.eb57c34"
  }
}
